<Window
    x:Class="BetterDemo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="AppRoot" RequestedTheme="Dark" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="8" BorderBrush="{StaticResource StudioCardStroke}" BorderThickness="1">
                    <Image x:Name="BrandMark" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="BetterDemo" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Studio" Foreground="{StaticResource StudioMutedText}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Background="Transparent" VerticalScrollBarVisibility="Auto">
            <Grid Padding="24" ColumnSpacing="20" MaxWidth="1440" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Studio" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Build a scene, check the output, then share it." Foreground="{StaticResource StudioMutedText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="{StaticResource StudioCardFill}" BorderBrush="{StaticResource StudioCardStroke}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Scene" FontSize="18" FontWeight="SemiBold" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Scene mode" Foreground="{StaticResource StudioMutedText}" />
                                <ComboBox x:Name="ModePicker" HorizontalAlignment="Stretch" SelectionChanged="ModePicker_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Physical camera" Foreground="{StaticResource StudioMutedText}" VerticalAlignment="Center" />
                                    <Button x:Name="RefreshPhysicalCamerasButton" Content="Refresh" Click="RefreshPhysicalCamerasButton_Click" HorizontalAlignment="Right" Padding="10,4" />
                                </Grid>
                                <ComboBox x:Name="PhysicalCameraPicker" HorizontalAlignment="Stretch" SelectionChanged="PhysicalCameraPicker_SelectionChanged" />
                                <TextBlock x:Name="PhysicalCameraStatusText" Text="Searching for connected cameras…" Foreground="{StaticResource StudioMutedText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Output resolution" Foreground="{StaticResource StudioMutedText}" />
                                <ComboBox x:Name="OutputResolutionPicker" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="StartPreviewButton" Content="Start preview" Click="StartPreviewButton_Click" />
                                <Button x:Name="ShowOutputButton" Content="Show output" Click="ShowOutputButton_Click" IsEnabled="False" />
                            </StackPanel>
                            <Button x:Name="HideOutputButton" Content="Hide output" Click="HideOutputButton_Click" IsEnabled="False" HorizontalAlignment="Left" />
                            <TextBlock x:Name="PerformanceText" Text="Preview metrics: idle." TextWrapping="Wrap" Foreground="{StaticResource StudioMutedText}" />
                        </StackPanel>
                    </Border>

                    <ContentControl x:Name="SourcesPanel">
                        <ContentControl.Content>
                            <Border Background="{StaticResource StudioCardFill}" BorderBrush="{StaticResource StudioCardStroke}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Sources" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Image sources sit above the selected camera scene." Foreground="{StaticResource StudioMutedText}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="SaveSceneButton" Content="Save" Click="SaveSceneButton_Click" />
                                        <Button x:Name="LoadSceneButton" Content="Load" Click="LoadSceneButton_Click" />
                                        <Button x:Name="UndoSceneButton" Content="Undo" Click="UndoSceneButton_Click" IsEnabled="False" />
                                        <Button x:Name="RedoSceneButton" Content="Redo" Click="RedoSceneButton_Click" IsEnabled="False" />
                                    </StackPanel>
                                    <Button x:Name="AddImageSourceButton" Content="Add image source…" Click="AddImageSourceButton_Click" HorizontalAlignment="Left" />
                                    <ListView x:Name="ImageSourcesList" Height="120" SelectionMode="Single" SelectionChanged="ImageSourcesList_SelectionChanged" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="RemoveImageSourceButton" Content="Remove" Click="RemoveImageSourceButton_Click" IsEnabled="False" />
                                        <Button x:Name="ToggleImageSourceVisibilityButton" Content="Hide" Click="ToggleImageSourceVisibilityButton_Click" IsEnabled="False" />
                                        <Button x:Name="BringImageSourceForwardButton" Content="Forward" Click="BringImageSourceForwardButton_Click" IsEnabled="False" />
                                        <Button x:Name="SendImageSourceBackwardButton" Content="Backward" Click="SendImageSourceBackwardButton_Click" IsEnabled="False" />
                                    </StackPanel>
                                    <TextBlock Text="Selected source transform" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <Grid ColumnSpacing="10" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="X" Grid.Row="0" VerticalAlignment="Center" />
                                        <Slider x:Name="ImageSourceXSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="0" StepFrequency="0.01" IsEnabled="False" ValueChanged="ImageSourceTransform_ValueChanged" PointerPressed="ImageSourceTransform_PointerPressed" PointerReleased="ImageSourceTransform_PointerReleased" />
                                        <TextBlock Text="Y" Grid.Row="1" VerticalAlignment="Center" />
                                        <Slider x:Name="ImageSourceYSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" StepFrequency="0.01" IsEnabled="False" ValueChanged="ImageSourceTransform_ValueChanged" PointerPressed="ImageSourceTransform_PointerPressed" PointerReleased="ImageSourceTransform_PointerReleased" />
                                        <TextBlock Text="Width" Grid.Row="2" VerticalAlignment="Center" />
                                        <Slider x:Name="ImageSourceWidthSlider" Grid.Row="2" Grid.Column="1" Minimum="0.05" Maximum="1" Value="1" StepFrequency="0.01" IsEnabled="False" ValueChanged="ImageSourceTransform_ValueChanged" PointerPressed="ImageSourceTransform_PointerPressed" PointerReleased="ImageSourceTransform_PointerReleased" />
                                        <TextBlock Text="Height" Grid.Row="3" VerticalAlignment="Center" />
                                        <Slider x:Name="ImageSourceHeightSlider" Grid.Row="3" Grid.Column="1" Minimum="0.05" Maximum="1" Value="1" StepFrequency="0.01" IsEnabled="False" ValueChanged="ImageSourceTransform_ValueChanged" PointerPressed="ImageSourceTransform_PointerPressed" PointerReleased="ImageSourceTransform_PointerReleased" />
                                        <TextBlock Text="Rotate" Grid.Row="4" VerticalAlignment="Center" />
                                        <Slider x:Name="ImageSourceRotationSlider" Grid.Row="4" Grid.Column="1" Minimum="-180" Maximum="180" Value="0" StepFrequency="1" IsEnabled="False" ValueChanged="ImageSourceTransform_ValueChanged" PointerPressed="ImageSourceTransform_PointerPressed" PointerReleased="ImageSourceTransform_PointerReleased" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ContentControl.Content>
                    </ContentControl>

                    <Border Background="{StaticResource StudioCardFill}" BorderBrush="{StaticResource StudioCardStroke}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Audio routing" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Route all Windows audio to the selected output. Discord and its child processes are always excluded." Foreground="{StaticResource StudioMutedText}" TextWrapping="Wrap" />
                            <Button Content="Refresh output devices" Click="RefreshAudioButton_Click" HorizontalAlignment="Left" />
                            <TextBlock Text="Output device" />
                            <ComboBox x:Name="AudioOutputPicker" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Output level" />
                            <Slider x:Name="AudioVolumeSlider" Minimum="0" Maximum="100" Value="100" StepFrequency="1" ValueChanged="AudioVolumeSlider_ValueChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AudioRouteButton" Content="Start system audio" Click="AudioRouteButton_Click" />
                                <Button x:Name="AudioToneButton" Content="Test tone" Click="AudioToneButton_Click" IsEnabled="False" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AudioMuteSwitch" Header="Mute routed system audio" Toggled="AudioMuteSwitch_Toggled" />
                            <TextBlock x:Name="AudioStatusText" Text="System audio route stopped." Foreground="{StaticResource StudioMutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="{StaticResource StudioCardFill}" BorderBrush="{StaticResource StudioCardStroke}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="12">
                            <Grid>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Demo image" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="A ready-made still source for checking the scene and Discord output." Foreground="{StaticResource StudioMutedText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Background="#FF18333B" CornerRadius="10" Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="1280 × 720" Foreground="{StaticResource StudioAccent}" FontSize="12" />
                                </Border>
                            </Grid>
                            <Border CornerRadius="10" BorderBrush="{StaticResource StudioCardStroke}" BorderThickness="1">
                                <Image x:Name="DemoCardPreview" Height="320" Stretch="Uniform" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="AddDemoSourceButton" Content="Add demo card to scene" Click="AddDemoSourceButton_Click" />
                                <TextBlock Text="Added as an editable image layer." Foreground="{StaticResource StudioMutedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource StudioCardFill}" BorderBrush="{StaticResource StudioCardStroke}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Connect your phone" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" LineHeight="22">
                                <Run Text="1. Put the phone and PC on the same private Wi‑Fi network." />
                                <LineBreak />
                                <Run Text="2. Start LAN remote. Wi‑Fi is selected automatically when available." />
                                <LineBreak />
                                <Run Text="3. On the phone, open BetterDemo Remote and tap SCAN DESKTOP QR." />
                                <LineBreak />
                                <Run Text="4. Tap PAIR DESKTOP once. Video stays on this PC." />
                            </TextBlock>
                            <TextBlock Text="Network interface" Foreground="{StaticResource StudioMutedText}" />
                            <ComboBox x:Name="LanAddressPicker" HorizontalAlignment="Stretch" />
                            <Button x:Name="RemoteServerButton" Content="Start LAN remote" Click="RemoteServerButton_Click" HorizontalAlignment="Left" />
                            <Border Background="#FF171B22" BorderBrush="{StaticResource StudioCardStroke}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBlock x:Name="PairingInfoText" Text="Pairing details will appear here after LAN remote starts. The phone and PC must be on the same private network." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Border>
                            <StackPanel x:Name="PairingQrPanel" Orientation="Horizontal" Spacing="14" Visibility="Collapsed">
                                <Border Background="White" CornerRadius="8" Padding="8" VerticalAlignment="Top">
                                    <Image x:Name="PairingQrImage" Width="220" Height="220" Stretch="Uniform" />
                                </Border>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Scan to pair" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="In BetterDemo Remote, tap SCAN DESKTOP QR. The code fills in the private address and TLS pin; tap PAIR DESKTOP to connect." Foreground="{StaticResource StudioMutedText}" TextWrapping="Wrap" MaxWidth="300" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource StudioCardFill}" BorderBrush="{StaticResource StudioCardStroke}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Status" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" />
                            <TextBlock Text="Diagnostics" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <ListView x:Name="DiagnosticsList" Height="180" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
